{
  "opencollection": "1.0.0",
  "info": {
    "name": "Infrahub Artifact Auth API",
    "version": "1.10.0"
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Login User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Login User"
        },
        {
          "info": {
            "name": "Refresh Jwt Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/refresh",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Refresh Jwt Token"
        },
        {
          "info": {
            "name": "Logout",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Logout"
        },
        {
          "info": {
            "name": "Login Ldap",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/ldap/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Login Ldap"
        }
      ]
    }
  ],
  "bundled": true
}