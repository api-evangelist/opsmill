{
  "opencollection": "1.0.0",
  "info": {
    "name": "Infrahub Artifact Telemetry API",
    "version": "1.10.0"
  },
  "items": [
    {
      "info": {
        "name": "Telemetry",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Telemetry Snapshots",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/telemetry/snapshots",
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Include snapshots created on or after this date (ISO 8601)"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "Include snapshots created on or before this date (ISO 8601)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of snapshots to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of snapshots to skip"
              },
              {
                "name": "branch",
                "value": "",
                "type": "query",
                "description": "Name of the branch to use for the query"
              },
              {
                "name": "at",
                "value": "",
                "type": "query",
                "description": "Time to use for the query, in absolute or relative format"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Telemetry Snapshots"
        }
      ]
    }
  ],
  "bundled": true
}