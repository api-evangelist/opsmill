              },
              {
                "name": "at",
                "value": "",
                "type": "query",
                "description": "Time to use for the query, in absolute or relative format"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Menu"
        }
      ]
    }
  ],
  "bundled": true
